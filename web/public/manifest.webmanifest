{
  "name": "Tessitura · Voice Trainer",
  "short_name": "Tessitura",
  "description": "Private, in-browser voice training powered by Praat.",
  "start_url": "./#/live",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0d0d",
